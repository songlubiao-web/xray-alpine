{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 3000,
      "protocol": "vless",
      "settings": {
        "clients": [
          { "id": "@UUID@", "level": 0 }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/@WSPATH@"
        }
      }
    }
  ],
  "outbounds": [
    { "protocol": "freedom" }
  ]
}
